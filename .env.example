# Copiar a .env (que NO se sube a git):  cp .env.example .env
# Zona horaria de los contenedores (para "hoy" y "ayer" de Saltillo)
TZ=America/Monterrey
# Puerto local del proxy: http://localhost:8081
PUERTO_PROXY=8081
# Opcional: túnel con nombre (URL fija). El quick tunnel no necesita nada.
# TUNNEL_TOKEN=
